#!/usr/bin/env sh

set -eu

ROOT_DIR="$(git rev-parse --show-toplevel)"
. "$ROOT_DIR/shell/git-hooks/common.sh"

MESSAGE_FILE="${1:?commit message file is required}"

# 项目提交消息遵循全局规范；只校验，不改写消息。
ensure_command python3
exec python3 "$ROOT_DIR/shell/git-hooks/validate_commit_message.py" "$MESSAGE_FILE"
