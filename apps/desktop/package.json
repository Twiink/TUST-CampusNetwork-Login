{
  "name": "netmate-desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "pnpm -C ../../packages/shared build",
    "build": "vite build",
    "dist": "pnpm run build && electron-builder --publish never",
    "dist:win": "pnpm run build && electron-builder --win --publish never",
    "dist:mac": "pnpm run build && electron-builder --mac --publish never",
    "dist:linux": "pnpm run build && electron-builder --linux --publish never",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "corepack pnpm -C ../../packages/shared build && node ./scripts/ensure-electron-binary.mjs && corepack pnpm run build && playwright test -c playwright.config.ts"
  },
  "description": "NetMate - 校园网自动登录助手",
  "homepage": "https://github.com/Twiink/TUST-Campusnet-Login#readme",
  "dependencies": {
    "@repo/native": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@repo/shared": "workspace:*",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/auto-launch": "^5.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "3.2.4",
    "auto-launch": "^5.0.6",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "electron-updater": "^6.6.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "26.1.0",
    "lucide-react": "^0.562.0",
    "playwright": "^1.58.2",
    "prettier": "^3.4.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "3.2.4"
  },
  "main": "dist-electron/main.js"
}
