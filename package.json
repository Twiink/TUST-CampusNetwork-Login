{
  "name": "netmate",
  "version": "2.0.0",
  "packageManager": "pnpm@10.27.0",
  "description": "NetMate - 校园网自动登录助手",
  "main": "index.js",
  "scripts": {
    "dev:desktop": "python3 tools/native/build.py --run",
    "dev:mobile": "bash apps/mobile/android/gradlew -p apps/mobile/android :app:installDebug",
    "android": "bash apps/mobile/android/gradlew -p apps/mobile/android :app:installDebug",
    "build": "python3 tools/native/build.py --release",
    "build:desktop": "python3 tools/native/build.py --release",
    "dist": "python3 tools/native/package.py",
    "dist:win": "python3 tools/native/package.py --format exe",
    "dist:mac": "python3 tools/native/package.py --format mac",
    "dist:linux": "python3 tools/native/package.py --format deb",
    "dist:android": "bash apps/mobile/android/gradlew -p apps/mobile/android :app:assembleRelease",
    "test": "cargo test --locked -p netmate-core -p netmate-platform",
    "test:native": "cargo test --locked -p netmate-core -p netmate-platform",
    "test:mobile": "bash apps/mobile/android/gradlew -p apps/mobile/android :app:testDebugUnitTest",
    "lint": "cargo clippy --locked -p netmate-core -p netmate-agent -p netmate-ui -- -D warnings",
    "format": "cargo fmt --all",
    "format:check": "cargo fmt --all -- --check",
    "legacy:dev:desktop": "pnpm -C apps/desktop dev",
    "legacy:test:shared": "pnpm -C packages/shared test",
    "legacy:test:desktop": "pnpm -C apps/desktop test",
    "legacy:test:mobile": "pnpm -C apps/mobile test --runInBand",
    "legacy:test:release": "node --test shell/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Twiink/TUST-Campusnet-Login.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Twiink/TUST-Campusnet-Login/issues"
  },
  "homepage": "https://github.com/Twiink/TUST-Campusnet-Login#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
